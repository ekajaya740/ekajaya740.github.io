---
import '@/styles/global.css';
import Head from '@/components/seo/Head.astro';
---

<!--
  The blog index is intentionally a redirect while the section is "coming soon"
  (it is already excluded from the sitemap). Individual posts stay reachable by
  direct link and from RSS.

  This is a real .astro page rather than Astro's `redirects` config on purpose:
  astro-takumi's build:done hook throws on any emitted page lacking og:title /
  og:url / og:type / og:image, and a generated meta-refresh stub has none. Going
  through Head.astro keeps the page valid and gives it a generated card.

  `noindex` keeps the redirect out of search results; `nofollow` isn't used so
  any accumulated links still pass through to the homepage.
-->
<html lang="en" dir="ltr">
  <head>
    <Head
      title="Blog — Work of Ekajaya"
      description="Writings on engineering, systems, and building things that matter. Coming soon."
      indexable={false}
      canonical="/"
    />
    <meta http-equiv="refresh" content="0; url=/" />
  </head>
  <body class="min-h-screen flex items-center justify-center px-6">
    <main class="max-w-3xl w-full">
      <p class="font-mono text-xs tracking-[0.3em] text-accent mb-3">BLOG</p>
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl font-bold text-foreground">
        Coming soon.
      </h1>
      <p class="mt-6 text-muted-foreground leading-relaxed max-w-xl">
        The blog isn't public yet. Taking you back to the homepage…
      </p>
      <a
        href="/"
        class="mt-10 inline-flex items-center gap-2 font-mono text-sm text-accent hover:text-accent/80 transition-colors"
      >
        <span aria-hidden="true">←</span> Back to the homepage
      </a>
    </main>
  </body>
</html>
