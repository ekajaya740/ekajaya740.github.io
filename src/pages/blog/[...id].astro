---
import Layout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} — Blog`}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.pubDate.toISOString()}
  modifiedTime={entry.data.updatedDate?.toISOString()}
  chrome={false}
>
  <article class="max-w-3xl mx-auto px-6 py-24 md:py-32">
    <header class="mb-12">
      <p class="font-mono text-xs tracking-[0.3em] text-accent mb-3">BLOG</p>

      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl font-bold text-foreground mb-6 text-balance">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
        <span>By {entry.data.author}</span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {entry.data.updatedDate && (
          <span>
            (Updated {entry.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })})
          </span>
        )}
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="text-[10px] font-mono px-2 py-1 border border-border rounded-full text-muted-foreground">{tag}</span>
        ))}
      </div>
    </header>

    <!-- No @tailwindcss/typography here; style MDX output directly with design-system tokens. -->
    <div class="text-muted-foreground leading-relaxed [&_h2]:font-[family-name:var(--font-display)] [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-foreground [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:font-[family-name:var(--font-display)] [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-foreground [&_h3]:mt-10 [&_h3]:mb-3 [&_p]:my-5 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-accent/80 [&_strong]:text-foreground [&_strong]:font-bold [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_li]:marker:text-border [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-foreground [&_code]:font-mono [&_code]:text-sm [&_code]:text-accent-yellow [&_code]:bg-card [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_pre]:bg-card [&_pre]:border [&_pre]:border-border [&_pre]:rounded-lg [&_pre]:p-5 [&_pre]:overflow-x-auto [&_pre]:my-6 [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-foreground [&_hr]:border-border [&_hr]:my-10 [&_img]:rounded-lg [&_img]:border [&_img]:border-border">
      <Content />
    </div>

    <nav class="mt-16 pt-8 border-t border-border">
      <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← Back to all posts</a>
    </nav>
  </article>
</Layout>
